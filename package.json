{
  "name": "cunat-chat",
  "version": "2.0.0",
  "description": "Cunat Chat - Secure messaging with your friends",
  "main": "dist/server/index.js",
  "scripts": {
    "dev:server": "tsc -w",
    "dev:client": "vite",
    "build:server": "tsc",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm start"
  },
  "keywords": [
    "chat",
    "websocket",
    "invite",
    "react"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "mongoose": "^9.1.3",
    "web-push": "^3.6.7",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "mongodb-memory-server": "^11.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.10"
  }
}
