{
  "name": "invite-chat",
  "version": "1.0.0",
  "description": "A chat app where friends can discuss in groups or directly via invite codes",
  "main": "dist/server/index.js",
  "scripts": {
    "build:server": "tsc",
    "build:client": "esbuild src/client/index.ts --bundle --outfile=public/js/app.js",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm start"
  },
  "keywords": ["chat", "websocket", "invite"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
